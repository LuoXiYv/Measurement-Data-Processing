<Window x:Class="Matrix_mod.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Matrix_mod"
        mc:Ignorable="d"
        Title="矩阵计算" Height="620" Width="980">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0">
            <TextBlock Text="输入矩阵时，行与行用换行分隔，列内用空格或逗号分隔。" />
            <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock Text="A 行:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="ARowsTextBox" Width="60" Text="2" Margin="0,0,10,0" />
                <TextBlock Text="A 列:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="AColsTextBox" Width="60" Text="2" Margin="0,0,20,0" />
                <Button x:Name="RandomAButton" Content="随机生成A" Click="RandomAButton_OnClick" Margin="0,0,20,0" />

                <TextBlock Text="B 行:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="BRowsTextBox" Width="60" Text="2" Margin="0,0,10,0" />
                <TextBlock Text="B 列:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="BColsTextBox" Width="60" Text="2" Margin="0,0,20,0" />
                <Button x:Name="RandomBButton" Content="随机生成B" Click="RandomBButton_OnClick" />
            </WrapPanel>

            <WrapPanel Margin="0,8,0,0">
                <Button Content="A + B" Click="AddButton_OnClick" Margin="0,0,8,0" />
                <Button Content="A - B" Click="SubtractButton_OnClick" Margin="0,0,8,0" />
                <Button Content="A × B" Click="MultiplyButton_OnClick" Margin="0,0,8,0" />
                <Button Content="求逆 A" Click="InverseAButton_OnClick" Margin="0,0,8,0" />
                <Button Content="转置 A" Click="TransposeAButton_OnClick" Margin="0,0,8,0" />
                <Button Content="求逆 B" Click="InverseBButton_OnClick" Margin="0,0,8,0" />
                <Button Content="转置 B" Click="TransposeBButton_OnClick" Margin="0,0,8,0" />
                <Button Content="清空" Click="ClearButton_OnClick" />
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="矩阵 A 输入" Grid.Column="0">
                <TextBox x:Name="MatrixATextBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </GroupBox>

            <GroupBox Header="矩阵 B 输入" Grid.Column="2">
                <TextBox x:Name="MatrixBTextBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </GroupBox>
        </Grid>

        <GroupBox Header="结果输出" Grid.Row="2" Margin="0,8,0,0">
            <TextBox x:Name="ResultTextBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsReadOnly="True" />
        </GroupBox>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Margin="0,8,0,0" Foreground="DarkGreen" />
    </Grid>
</Window>
