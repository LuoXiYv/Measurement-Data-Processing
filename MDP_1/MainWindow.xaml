<Window x:Class="MDP_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MDP_1"
        mc:Ignorable="d"
        Title="三角形闭合差统计" Height="740" Width="1100" MinHeight="600" MinWidth="950">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="260" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Button Width="120" Height="32" Margin="0,0,8,0" Content="读取数据" Click="LoadDataButton_Click" />
            <Button Width="120" Height="32" Margin="0,0,8,0" Content="统计计算" Click="CalculateButton_Click" />
            <Button Width="120" Height="32" Margin="0,0,16,0" Content="导出结果" Click="ExportButton_Click" />
            <TextBlock VerticalAlignment="Center" Text="分组宽度 d=0.2，统计范围 |Δ|&lt;=2.6" />
        </StackPanel>

        <TextBlock x:Name="SummaryTextBlock"
                   Grid.Row="1"
                   Margin="0,0,0,8"
                   Text="请先读取闭合差数据文件。"
                   TextWrapping="Wrap" />

        <DataGrid x:Name="StatisticsDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="误差区间 |Δ|" Binding="{Binding IntervalLabel}" Width="*" />
                <DataGridTextColumn Header="-Δ 个数" Binding="{Binding NegativeCount}" Width="100" />
                <DataGridTextColumn Header="-Δ 频率" Binding="{Binding NegativeFrequency, StringFormat=F6}" Width="120" />
                <DataGridTextColumn Header="-Δ 频率密度" Binding="{Binding NegativeDensity, StringFormat=F6}" Width="130" />
                <DataGridTextColumn Header="+Δ 个数" Binding="{Binding PositiveCount}" Width="100" />
                <DataGridTextColumn Header="+Δ 频率" Binding="{Binding PositiveFrequency, StringFormat=F6}" Width="120" />
                <DataGridTextColumn Header="+Δ 频率密度" Binding="{Binding PositiveDensity, StringFormat=F6}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" BorderThickness="1" BorderBrush="Gainsboro" Padding="8">
            <Canvas x:Name="ChartCanvas" Background="White" />
        </Border>
    </Grid>
</Window>
